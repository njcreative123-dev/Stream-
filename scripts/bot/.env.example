# NJStream Bot — environment config (placeholders replace karo)
BOT_TOKEN=your_bot_token_here
BOT_TOKENS=token1,token2   # multi-token rotation (optional, comma)
WORKER_URL=https://your-worker.workers.dev
INGEST_KEY=your_ingest_key_here
CHAT_IDS=-100xxxxxxxxxx              # group/channel ids (comma list)
# Self-hosted Telegram Bot API (--local mode, 20MB limit removed)
PRIMARY_API_URL=http://YOUR_IP:8081
BACKUP_API_URL=http://YOUR_IP:8091
LOCAL_BOT_API_URL=http://YOUR_IP:8081
